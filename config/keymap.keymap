#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        lay4esc {
            bindings = <&lt 4 ESCAPE>;
            key-positions = <58 59>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <27 26>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none     &none     &none     &none                                            &none        &none  &none      &none         &none         &none
&none  &kp Q             &kp W     &kp E     &kp R     &kp T                                            &kp Y        &kp U  &kp I      &kp O         &kp P         &none
&none  &kp A             &kp S     &kp D     &kp F     &kp G        &none             &none             &kp H        &kp J  &kp K      &kp L         &kp SEMI      &none
&none  &mt LEFT_SHIFT Z  &kp X     &kp C     &kp V     &kp B        &mkp LCLK         &mkp RCLK         &kp N        &kp M  &kp COMMA  &kp DOT       &kp SLASH     &none
&none  &kp LCTRL         &kp LGUI  &kp LALT  &kp BSPC  &lt 2 SPACE  &lt 3 LANGUAGE_2  &lt 3 LANGUAGE_1  &lt 1 ENTER  &none  &none      &kp C_VOL_DN  &kp C_VOL_UP  &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans        &trans        &trans            &trans             &trans                        &trans        &trans                &trans                 &trans        &trans                &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7          &kp NUMBER_8           &kp NUMBER_9  &kp NUMBER_0          &trans
&trans  &trans        &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans        &trans  &trans  &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans        &kp NON_US_BACKSLASH  &trans
&trans  &trans        &trans        &trans            &trans             &trans        &trans  &trans  &trans        &none                 &trans                 &trans        &kp PIPE              &trans
&trans  &trans        &trans        &trans            &trans             &trans        &trans  &trans  &trans        &trans                &trans                 &trans        &trans                &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans             &trans             &trans      &trans                         &trans         &trans            &trans     &trans     &trans     &trans
&trans  &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp POUND          &kp DOLLAR  &kp PERCENT                    &kp AMPERSAND  &kp SINGLE_QUOTE  &kp EQUAL  &kp TILDE  &kp PIPE   &trans
&trans  &kp GRAVE        &kp TILDE          &kp DOUBLE_QUOTES  &kp SQT     &none        &trans   &trans   &mkp MB3       &mkp MB1          &mkp MB2   &kp PLUS   &kp MINUS  &trans
&trans  &kp F1           &kp F2             &kp F3             &kp F4      &kp F5       &kp F11  &kp F12  &kp F6         &kp F7            &kp F8     &kp F9     &kp F10    &trans
&trans  &trans           &trans             &trans             &trans      &trans       &trans   &trans   &none          &none             &trans     &trans     &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans           &trans            &trans                  &trans                             &trans        &trans      &trans          &trans         &trans  &trans
&trans  &none   &kp LC(LS(TAB))  &kp PSCRN         &kp LC(TAB)             &kp LG(LS(S))                      &kp K_MUTE    &kp HOME    &kp UP_ARROW    &kp END        &none   &trans
&trans  &none   &kp LG(LEFT)     &kp LG(RIGHT)     &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT))  &trans  &trans  &kp C_VOL_UP  &kp LEFT    &kp DOWN_ARROW  &kp RIGHT      &none   &trans
&trans  &none   &kp LSHIFT       &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))       &none              &trans  &trans  &kp C_VOL_DN  &kp DELETE  &kp PG_UP       &kp PAGE_DOWN  &none   &trans
&trans  &trans  &trans           &trans            &none                   &none              &trans  &trans  &trans        &trans      &trans          &trans         &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
